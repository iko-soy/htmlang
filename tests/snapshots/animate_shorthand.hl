@page Animate
@style
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
@style
  @keyframes slide-up {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
@el [spacing 20, padding 20]
  @el [animation fade-in 0.3s ease, padding 20]
    Faded in
  @el [animation slide-up 0.5s ease-out, padding 20, background #e5e7eb]
    Slid up
