-- A function is called like an element: on its own line, in a chain, or
-- inline in text.
@let @key
  @kbd [padding 1 6, border 1 solid #d1d5db, border-radius 4]
    @children

@paragraph
  Press {@key Ctrl+K} to search, or {@key [background #f3f4f6] Esc} to close.

-- Parameters bind by name; everything else goes to the root element.
@let @card [title, featured false]
  @article [padding 16]
    @h3 $title
    @if $featured
      @text Featured
    @children
@card [title Plain, featured, padding 24, id=intro, center-x]
  Body

-- In a chain, and with a chain after it.
@el [padding 8] > @card [title Chained]
  Child of the card
@card [title Linked] > @link /more More

-- A body with several roots, or a text body, stands in its place.
@let @pair
  @text [color #b91c1c] One
  @text [color #1d4ed8] Two
@let @intro
  htmlang is a layout language.
  It compiles to {@text [font-weight bold] static HTML}.
@paragraph
  Inline: {@pair}. In short, {@intro}
@row [spacing 8] > @pair

-- A function in the content its caller passes is not recursion.
@let @box
  @el [padding 4, border 1 solid #e5e7eb]
    @children
@box
  @box
    Inner
  {@key nested} in text

-- A function may call itself under a condition, and a parameter passed a
-- record or a list gets all of it.
@data $menu [
  {"label": "Guide", "children": [
    {"label": "Install", "children": [{"label": "Linux"}, {"label": "macOS"}]},
    {"label": "Usage"}
  ]},
  {"label": "Reference"}
]
@let @tree [items, depth 0]
  @ul [padding-left 12]
    @each $item in $items
      @li
        @text $item.label (level $depth)
        @if $item.children
          @tree [items $item.children, depth ${$depth + 1}]
@tree [items $menu]

@data $post {"title": "Hello", "author": {"name": "Ada"}}
@let @byline [post]
  @text $post.title by $post.author.name
@byline [post $post]
