@page Pseudo States Extended

@el [padding 10, focus-visible:border 2 solid blue, focus-within:background #eee]
  @input [type=text, placeholder=Name]

@el [disabled:opacity 0.5, checked:background green]

@input [type=text, placeholder:color #999]

@el [first-child:border-top 0, last-child:border-bottom 0]

@row [spacing 10]
  @el [nth-child(odd):background #f5f5f5, nth-child(even):background white, padding 10]
    Item
