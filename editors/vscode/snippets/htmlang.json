{
  "Page boilerplate": {
    "prefix": "@page",
    "body": [
      "@page ${1:My Page}",
      "@let primary ${2:#3b82f6}",
      "",
      "@column [max-width ${3:800}, center-x, padding ${4:40}, spacing ${5:20}]",
      "  $0"
    ],
    "description": "Page boilerplate with title, variables, and layout"
  },
  "Function component": {
    "prefix": "@let-fn",
    "body": [
      "@let ${1:component} \\$${2:title}",
      "  @el [${3:padding 20, background white, rounded 8}]",
      "    @text [bold] \\$$2",
      "    @children",
      "",
      "@$1 [$2 ${4:Hello}]",
      "  $0"
    ],
    "description": "Reusable function component with @children slot"
  },
  "Function with named slots": {
    "prefix": "@let-slots",
    "body": [
      "@let ${1:layout} \\$${2:title}",
      "  @column [${3:max-width 800, center-x, padding 40}]",
      "    @slot ${4:header}",
      "      @text [bold, size 32] \\$$2",
      "    @slot ${5:content}",
      "    @slot ${6:footer}",
      "",
      "@$1 [$2 ${7:My Page}]",
      "  @slot $5",
      "    $0"
    ],
    "description": "Function with named slots for multi-region layouts"
  },
  "Card component": {
    "prefix": "@card",
    "body": [
      "@el [padding ${1:20}, background ${2:white}, rounded ${3:8}, border 1 ${4:#e5e7eb}, hover:border 1 ${5:\\$primary}, transition all 0.15s ease]",
      "  @text [bold, size ${6:18}] ${7:Title}",
      "  $0"
    ],
    "description": "Card with border, hover effect, and title"
  },
  "Responsive row": {
    "prefix": "@responsive-row",
    "body": [
      "@row [wrap, spacing ${1:20}]",
      "  @el [width fill, min-width ${2:300}]",
      "    ${3:Column 1}",
      "  @el [width fill, min-width $2]",
      "    ${4:Column 2}",
      "  $0"
    ],
    "description": "Responsive wrapping row layout"
  },
  "Navigation bar": {
    "prefix": "@navbar",
    "body": [
      "@nav [padding-x ${1:20}, padding-y ${2:12}, background ${3:#1a1a2e}]",
      "  @row [spacing ${4:20}, align-items center]",
      "    @text [bold, color ${5:white}, size ${6:18}] ${7:Logo}",
      "    @el [width fill]",
      "    @each \\$name, \\$url in ${8:Home /, About /about, Contact /contact}",
      "      @link \\$url",
      "        @text [color ${9:#a8b2d1}, hover:color white] \\$name",
      "    $0"
    ],
    "description": "Navigation bar with logo and links"
  },
  "Each loop": {
    "prefix": "@each",
    "body": [
      "@each \\$${1:item} in ${2:items}",
      "  $0",
      "@else",
      "  @text [color #888] No items found."
    ],
    "description": "Each loop with @else fallback"
  },
  "Conditional": {
    "prefix": "@if",
    "body": [
      "@if ${1:condition}",
      "  $0",
      "@else",
      "  "
    ],
    "description": "If/else conditional block"
  },
  "Grid layout": {
    "prefix": "@grid",
    "body": [
      "@grid [grid-cols ${1:3}, gap ${2:20}]",
      "  @el [padding ${3:20}]",
      "    ${4:Item 1}",
      "  @el [padding $3]",
      "    ${5:Item 2}",
      "  @el [padding $3]",
      "    ${6:Item 3}",
      "  $0"
    ],
    "description": "CSS Grid layout with columns"
  },
  "Grid with named areas": {
    "prefix": "@grid-areas",
    "body": [
      "@grid [grid-template-areas \"${1:header header}\" \"${2:sidebar main}\" \"${3:footer footer}\", gap ${4:20}]",
      "  @el [grid-area ${5:header}]",
      "    ${6:Header}",
      "  @el [grid-area ${7:sidebar}]",
      "    ${8:Sidebar}",
      "  @el [grid-area ${9:main}]",
      "    $0"
    ],
    "description": "CSS Grid with named template areas"
  },
  "Form with inputs": {
    "prefix": "@form",
    "body": [
      "@form [method=${1:post}, spacing ${2:16}] ${3:/submit}",
      "  @label [for=${4:email}] ${5:Email}",
      "  @input [type=${6:email}, name=$4, id=$4, required, padding 8, border 1 #d1d5db, rounded 4]",
      "  @button [type=submit, padding 10, background ${7:\\$primary}, color white, rounded 4, bold]",
      "    ${8:Submit}",
      "  $0"
    ],
    "description": "Form with labeled input and submit button"
  },
  "Dark mode toggle": {
    "prefix": "@darkmode",
    "body": [
      "@el [background ${1:white}, dark:background ${2:#1a1a2e}, color ${3:#333}, dark:color ${4:#eee}, transition all 0.2s ease]",
      "  $0"
    ],
    "description": "Element with light/dark mode styles"
  },
  "Hero section": {
    "prefix": "@hero",
    "body": [
      "@column [center-x, center-y, min-height ${1:80vh}, padding ${2:40}, spacing ${3:20}]",
      "  @text [bold, size ${4:48}, text-align center] ${5:Hero Title}",
      "  @paragraph [max-width ${6:600}, text-align center, color ${7:#666}, line-height 1.6]",
      "    ${8:Hero description text}",
      "  @el [padding 12 24, background ${9:\\$primary}, rounded 8] > @link ${10:#}",
      "    @text [color white, bold] ${11:Get Started}",
      "  $0"
    ],
    "description": "Hero section with title, description, and CTA"
  },
  "Theme tokens": {
    "prefix": "@let-tokens",
    "body": [
      "@let --primary ${1:#3b82f6}",
      "@let --secondary ${2:#10b981}",
      "@let --radius ${3:8}",
      "$0"
    ],
    "description": "Design tokens as CSS custom properties (use as $--primary)"
  },
  "Keyframes animation": {
    "prefix": "@keyframes",
    "body": [
      "@style",
      "  @keyframes ${1:fade-in} {",
      "    from { opacity: 0; }",
      "    to { opacity: 1; }",
      "  }",
      "",
      "@el [animation $1 ${2:0.3s} ${3:ease}]",
      "  $0"
    ],
    "description": "Keyframe animation with element usage"
  },
  "Include/Import": {
    "prefix": "@include",
    "body": [
      "@include ${1:components.hl}",
      "$0"
    ],
    "description": "Include another file (a library of @let definitions emits nothing)"
  },
  "Layout": {
    "prefix": "@layout",
    "body": [
      "@include ${1:layout.hl}",
      "@${2:layout}",
      "  @slot ${3:header}",
      "    $0"
    ],
    "description": "Render the page inside a layout function"
  },
  "Script (external)": {
    "prefix": "@script-src",
    "body": [
      "@script [src=${1:app.js}, ${2:defer}]",
      "$0"
    ],
    "description": "External script tag with src attribute"
  },
  "Script (inline)": {
    "prefix": "@script",
    "body": [
      "@script",
      "  $0"
    ],
    "description": "Inline script block"
  },
  "Noscript fallback": {
    "prefix": "@noscript",
    "body": [
      "@noscript",
      "  @text ${1:JavaScript is required for this page.}",
      "  $0"
    ],
    "description": "Fallback content when JavaScript is disabled"
  },
  "Breadcrumb navigation": {
    "prefix": "@breadcrumb",
    "body": [
      "@breadcrumb",
      "  @item > @link ${1:/} ${2:Home}",
      "  @item > @link ${3:/docs} ${4:Docs}",
      "  @item ${5:Current Page}",
      "  $0"
    ],
    "description": "Breadcrumb navigation with links"
  },
  "Address block": {
    "prefix": "@address",
    "body": [
      "@address",
      "  @text [bold] ${1:Name}",
      "  @link mailto:${2:email@example.com} $2",
      "  $0"
    ],
    "description": "Contact address block"
  },
  "Search form": {
    "prefix": "@search",
    "body": [
      "@search",
      "  @input [type=search, placeholder=${1:Search...}]",
      "  @button [type=submit] ${2:Go}",
      "  $0"
    ],
    "description": "Search form with input and submit button"
  },
  "Font face": {
    "prefix": "@font-face",
    "body": [
      "@style",
      "  @font-face { font-family: '${1:Inter}'; src: url('${2:fonts/inter.woff2}') format('woff2'); font-display: swap; }",
      "$0"
    ],
    "description": "Custom font face in an @style block"
  },
  "JSON-LD structured data": {
    "prefix": "@json-ld",
    "body": [
      "@head",
      "  <script type=\"application/ld+json\">",
      "    {\"@context\": \"https://schema.org\", \"@type\": \"${1:WebPage}\", \"name\": \"${2:Page Title}\"}",
      "  </script>",
      "$0"
    ],
    "description": "JSON-LD structured data in @head"
  },
  "Page metadata": {
    "prefix": "@page-meta",
    "body": [
      "@page [lang ${1:en}, canonical ${2:https://example.com/page}, favicon ${3:/favicon.png}] ${4:My Page}",
      "@meta description ${5:Page description}",
      "@meta og:title $4",
      "$0"
    ],
    "description": "Page with language, canonical URL, favicon and meta tags"
  }
}
