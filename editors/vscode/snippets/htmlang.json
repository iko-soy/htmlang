{
  "Page": {
    "prefix": "@page",
    "body": [
      "@page [lang=${1:en}] ${2:My Page}",
      "@let --${3:brand} ${4:#3b82f6}",
      "",
      "@el [width fill, max-width ${5:800}, center-x, padding ${6:40}, spacing ${7:20}]",
      "  $0"
    ],
    "description": "A page with a title, tokens and a centered column"
  },
  "Page metadata": {
    "prefix": "@page-meta",
    "body": [
      "@page [lang=${1:en}, favicon ${2:favicon.png}] ${3:My Page}",
      "@meta description ${4:Page description}",
      "@meta og:title $3",
      "@head <link rel=\"canonical\" href=\"${5:https://example.com/}\">",
      "$0"
    ],
    "description": "A page with a description, Open Graph tags and a canonical link"
  },
  "Design tokens": {
    "prefix": "@let-tokens",
    "body": [
      "@let --${1:brand} ${2:#3b82f6}",
      "@let --${3:ink} ${4:#0f172a}",
      "@let --${5:muted} ${6:#64748b}",
      "$0"
    ],
    "description": "CSS custom properties on :root, values as written (a length takes its unit): var(--name) at run time, \\$--name at compile time; [--name value] sets one on an element and everything inside it"
  },
  "Dark mode tokens": {
    "prefix": "@page-theme",
    "body": [
      "@let --${1:ink} ${2:#0f172a}",
      "@let --${3:surface} ${4:white}",
      "@page [color var(--$1), background var(--$3), dark:[--$1 ${5:#e2e8f0}, --$3 ${6:#0b1220}]] ${7:My Page}",
      "$0"
    ],
    "description": "Colour tokens on :root, redefined once for dark mode on the page: everything that uses them follows"
  },
  "Attribute bundle": {
    "prefix": "@let-bundle",
    "body": [
      "@let ${1:card} [${2:padding 20, background white, border 1 solid #e5e7eb, border-radius 8}]",
      "$0"
    ],
    "description": "A named list of attributes, used as [\\$name]"
  },
  "Function": {
    "prefix": "@let-fn",
    "body": [
      "@let @${1:card} [${2:title}]",
      "  @el [${3:padding 20, spacing 8, border 1 solid #e5e7eb, border-radius 8}]",
      "    @text [font-weight bold] \\$$2",
      "    @children",
      "",
      "@$1 [$2 ${4:Hello}]",
      "  $0"
    ],
    "description": "A function with a required parameter and @children"
  },
  "Function with slots": {
    "prefix": "@let-slots",
    "body": [
      "@let @${1:panel} [${2:title}]",
      "  @article [${3:padding 20, spacing 12}]",
      "    @row [align-items center]",
      "      @h2 \\$$2",
      "      @spacer",
      "      @slot ${4:actions}",
      "    @children",
      "    @slot ${5:footer}",
      "      @text ${6:Default footer}",
      "",
      "@$1 [$2 ${7:Title}]",
      "  @slot $4",
      "    $0",
      "  Content"
    ],
    "description": "A function with named slots and default content"
  },
  "Scoped style": {
    "prefix": "@let-style",
    "body": [
      "@let @${1:note}",
      "  @style",
      "    & { ${2:border-left: 4px solid #3b82f6;} }",
      "  @el [${3:padding 12 16}]",
      "    @children",
      "$0"
    ],
    "description": "A function with a stylesheet scoped to its root element"
  },
  "Layout": {
    "prefix": "@layout",
    "body": [
      "@include ${1:layout.hl}",
      "@${2:layout}",
      "  @slot ${3:header}",
      "    $0"
    ],
    "description": "Render the page inside a layout function from another file"
  },
  "Row": {
    "prefix": "@row",
    "body": [
      "@row [spacing ${1:16}, align-items ${2:center}]",
      "  $0"
    ],
    "description": "A row with spacing"
  },
  "Responsive row": {
    "prefix": "@responsive-row",
    "body": [
      "@row [spacing ${1:20}, wrap]",
      "  @el [flex 1 1 ${2:280}px]",
      "    ${3:Column 1}",
      "  @el [flex 1 1 $2px]",
      "    ${4:Column 2}",
      "$0"
    ],
    "description": "A row of columns that wraps on narrow screens"
  },
  "Grid": {
    "prefix": "@grid",
    "body": [
      "@grid [grid-cols ${1:3}, spacing ${2:20}, ${3:md:grid-cols 4}]",
      "  @el ${4:One}",
      "  @el ${5:Two}",
      "  @el ${6:Three}",
      "$0"
    ],
    "description": "A grid with equal columns"
  },
  "Grid with named areas": {
    "prefix": "@grid-areas",
    "body": [
      "@grid [grid-template-columns ${1:240 1fr}, grid-template-areas \"${2:header header}\" \"${3:sidebar main}\", spacing ${4:20}]",
      "  @header [grid-area header]",
      "    ${5:Header}",
      "  @aside [grid-area sidebar]",
      "    ${6:Sidebar}",
      "  @main [grid-area main]",
      "    $0"
    ],
    "description": "A grid with named template areas"
  },
  "Navigation bar": {
    "prefix": "@navbar",
    "body": [
      "@data \\$${1:links} [",
      "  {\"label\": \"${2:Home}\", \"url\": \"/\"},",
      "  {\"label\": \"${3:About}\", \"url\": \"/about\"}",
      "]",
      "@header [flex-direction row, spacing ${5:20}, align-items center, padding ${4:12 24}, border-bottom 1 solid #e5e7eb]",
      "  @text [font-weight bold] ${6:Logo}",
      "  @spacer",
      "  @nav [flex-direction row, spacing $5]",
      "    @each \\$link in \\$$1",
      "      @link [hover:text-decoration underline] \\$link.url \\$link.label",
      "$0"
    ],
    "description": "A header with a logo, a spacer and links from data"
  },
  "Hero": {
    "prefix": "@hero",
    "body": [
      "@section [padding ${1:96 24}, spacing ${2:24}, text-align center]",
      "  @h1 [font-size ${3:48}] ${4:Headline}",
      "  @paragraph [max-width ${5:600}, center-x, color #64748b, line-height 1.6]",
      "    ${6:A sentence about the product.}",
      "  @link [center-x, padding 12 24, border-radius 8, background ${7:#3b82f6}, color white, font-weight bold] ${8:/signup}",
      "    ${9:Get started}",
      "$0"
    ],
    "description": "A centered hero section with a call to action"
  },
  "Form": {
    "prefix": "@form",
    "body": [
      "@form [method=${1:post}, spacing ${2:12}] ${3:/submit}",
      "  @label [for=${4:email}] ${5:Email}",
      "  @input [type=${6:email}, name=$4, id=$4, required, padding 8, border 1 solid #d1d5db, border-radius 4]",
      "  @button [type=submit, padding 10 16, border 0, border-radius 4, background ${7:#3b82f6}, color white, font-weight bold] ${8:Submit}",
      "$0"
    ],
    "description": "A form with a labeled input and a submit button"
  },
  "Search": {
    "prefix": "@search",
    "body": [
      "@search",
      "  @form [spacing 8] ${1:/search}",
      "    @input [type=search, name=q, aria-label=Search, placeholder=${2:Search}]",
      "    @button [type=submit] ${3:Go}",
      "$0"
    ],
    "description": "A search form"
  },
  "Data": {
    "prefix": "@data",
    "body": [
      "@data \\$${1:items} ${2:items.json}",
      "$0"
    ],
    "description": "Load JSON: records are \\$name.key, arrays are lists"
  },
  "Each": {
    "prefix": "@each",
    "body": [
      "@each \\$${1:item} in \\$${2:items}",
      "  $0",
      "@else",
      "  @text Nothing here yet."
    ],
    "description": "Loop over a list, with a fallback for an empty one"
  },
  "Each in a range": {
    "prefix": "@each range",
    "body": [
      "@each \\$${1:i} in ${2:1}..${3:5}",
      "  $0"
    ],
    "description": "Loop over the numbers from a to b (add `step n` to skip)"
  },
  "If": {
    "prefix": "@if",
    "body": [
      "@if ${1:\\$condition}",
      "  $0",
      "@else",
      "  "
    ],
    "description": "A conditional with an else branch"
  },
  "Conditional attributes": {
    "prefix": "if(",
    "body": [
      "if(${1:\\$condition}, [${2:font-weight 600}]${3:, [${4:font-weight 400}]})"
    ],
    "description": "Attributes chosen by a condition: each branch is an attribute, a [group] or a \\$bundle"
  },
  "Dark mode": {
    "prefix": "@dark",
    "body": [
      "@el [background ${1:white}, color ${2:#111827}, dark:[background ${3:#111827}, color ${4:#f9fafb}]]",
      "  $0"
    ],
    "description": "Light and dark colors on one element: a prefix applies to a [group] of styles"
  },
  "Responsive group": {
    "prefix": "md:[",
    "body": [
      "${1:md}:[${2:padding 32}, ${3:font-size 20}]"
    ],
    "description": "Prefixes applied to a group of styles (or to a bundle: md:\\$card); prefixes stack, as in md:hover:color"
  },
  "Keyframes": {
    "prefix": "@keyframes",
    "body": [
      "@style",
      "  @keyframes ${1:fade-in} {",
      "    from { opacity: 0; }",
      "    to { opacity: 1; }",
      "  }",
      "",
      "@el [animation $1 ${2:0.3s} ${3:ease}]",
      "  $0"
    ],
    "description": "A keyframe animation in @style, used by an element"
  },
  "Font face": {
    "prefix": "@font-face",
    "body": [
      "@style @font-face { font-family: '${1:Inter}'; src: url('${2:fonts/inter.woff2}') format('woff2'); font-display: swap; }",
      "$0"
    ],
    "description": "A custom font in @style"
  },
  "JSON-LD": {
    "prefix": "@json-ld",
    "body": [
      "@head",
      "  <script type=\"application/ld+json\">",
      "    {\"@context\": \"https://schema.org\", \"@type\": \"${1:WebPage}\", \"name\": \"${2:Page Title}\"}",
      "  </script>",
      "$0"
    ],
    "description": "Structured data in @head"
  },
  "Include": {
    "prefix": "@include",
    "body": [
      "@include ${1:components.hl}",
      "$0"
    ],
    "description": "Include another file (a file of @let definitions outputs nothing)"
  },
  "Script": {
    "prefix": "@script",
    "body": [
      "@script",
      "  $0"
    ],
    "description": "An inline script"
  },
  "Table": {
    "prefix": "@table",
    "body": [
      "@table",
      "  @caption ${1:Title}",
      "  @thead",
      "    @tr",
      "      @th ${2:Name}",
      "  @tbody",
      "    @tr",
      "      @td ${3:Value}",
      "$0"
    ],
    "description": "A table with a caption, a header row and a body"
  },
  "List with markers": {
    "prefix": "@ul-markers",
    "body": [
      "@ul [list-style ${1:disc}, padding-inline-start 20, children:display list-item, children:marker:color ${2:currentColor}]",
      "  @li ${3:Item}",
      "$0"
    ],
    "description": "A list that shows its markers, with ::marker styled"
  },
  "External script": {
    "prefix": "@script-src",
    "body": [
      "@script [${2:defer}] ${1:app.js}",
      "$0"
    ],
    "description": "A script loaded from a file"
  },
  "Code sample": {
    "prefix": "@code-sample",
    "body": [
      "@pre [padding ${1:16}, background ${2:#f8fafc}, overflow-x auto] > @code",
      "  $0"
    ],
    "description": "A code sample: the lines under @code are shown as written, HTML-escaped"
  }
}
