{
  "name": "htmlang",
  "displayName": "htmlang",
  "description": "Language support for htmlang (.hl) files",
  "version": "0.1.0",
  "publisher": "htmlang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:htmlang",
    "workspaceContains:**/*.hl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "htmlang",
        "aliases": [
          "htmlang"
        ],
        "extensions": [
          ".hl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "htmlang",
        "scopeName": "source.htmlang",
        "path": "./syntaxes/htmlang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "htmlang",
        "path": "./snippets/htmlang.json"
      }
    ],
    "commands": [
      {
        "command": "htmlang.restartServer",
        "title": "htmlang: Restart Language Server"
      },
      {
        "command": "htmlang.showOutput",
        "title": "htmlang: Show Language Server Output"
      }
    ],
    "configuration": {
      "title": "htmlang",
      "properties": {
        "htmlang.server.path": {
          "type": "string",
          "default": "htmlang-lsp",
          "description": "Path to the htmlang-lsp binary"
        },
        "htmlang.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to the htmlang-lsp binary"
        },
        "htmlang.trace.server": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP protocol messages between VS Code and the htmlang language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w"
  }
}
