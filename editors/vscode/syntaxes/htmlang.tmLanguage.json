{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "htmlang",
  "scopeName": "source.htmlang",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#page-directive"
    },
    {
      "include": "#let-definition"
    },
    {
      "include": "#include-directive"
    },
    {
      "include": "#each-directive"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#literal-line"
    },
    {
      "include": "#element"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#escape"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#range"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#literal-inline"
    },
    {
      "include": "#inline-element"
    },
    {
      "include": "#color"
    },
    {
      "include": "#number"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-dash.htmlang",
      "match": "^\\s*--.*$"
    },
    "page-directive": {
      "match": "(@page)\\s+(.*)",
      "captures": {
        "1": {
          "name": "keyword.control.directive.htmlang"
        },
        "2": {
          "name": "string.unquoted.page-title.htmlang"
        }
      }
    },
    "let-definition": {
      "match": "(@let)\\s+(?:(@[a-zA-Z][a-zA-Z0-9_-]*)|(--[a-zA-Z][a-zA-Z0-9_-]*|[a-zA-Z_][a-zA-Z0-9_.-]*))",
      "captures": {
        "1": {
          "name": "keyword.control.directive.htmlang"
        },
        "2": {
          "name": "entity.name.function.htmlang"
        },
        "3": {
          "name": "variable.other.htmlang"
        }
      }
    },
    "include-directive": {
      "match": "(@(?:include|markdown|data))\\s+(.*)",
      "captures": {
        "1": {
          "name": "keyword.control.directive.htmlang"
        },
        "2": {
          "name": "string.unquoted.filename.htmlang"
        }
      }
    },
    "each-directive": {
      "match": "^\\s*(@each)\\s+(\\$[a-zA-Z_][a-zA-Z0-9_-]*)(?:\\s*,\\s*(\\$[a-zA-Z_][a-zA-Z0-9_-]*))?\\s+(in)(?![a-zA-Z0-9_-])",
      "captures": {
        "1": {
          "name": "keyword.control.directive.htmlang"
        },
        "2": {
          "name": "variable.other.htmlang"
        },
        "3": {
          "name": "variable.other.htmlang"
        },
        "4": {
          "name": "keyword.control.in.htmlang"
        }
      }
    },
    "directive": {
      "name": "keyword.control.directive.htmlang",
      "match": "@(?:page|let|include|data|meta|if|else|each|style|head|raw|markdown)(?![a-zA-Z0-9_-])"
    },
    "literal-line": {
      "comment": "@code and @textarea show their text as written: a {@...} in it is text",
      "begin": "(?:^\\s*|\\s>\\s*)(@(?:code|textarea))(?![a-zA-Z0-9_-])",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.htmlang"
        }
      },
      "contentName": "markup.inline.raw.htmlang",
      "patterns": [
        {
          "include": "#attributes"
        },
        {
          "include": "#escape"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "element": {
      "name": "entity.name.tag.htmlang",
      "match": "@(?:row|el|text|paragraph|image|link|children|slot|fragment|script|nav|header|footer|main|section|article|aside|address|search|form|details|summary|dialog|figure|figcaption|blockquote|cite|fieldset|legend|noscript|datalist|ul|ol|li|dl|dt|dd|table|thead|tbody|tr|td|th|select|picture|progress|meter|output|canvas|button|label|option|textarea|time|mark|abbr|code|kbd|pre|h1|h2|h3|h4|h5|h6|input|hr|source|video|audio|iframe|grid|in-front|behind)(?![a-zA-Z0-9_-])"
    },
    "function-call": {
      "name": "entity.name.function.htmlang",
      "match": "@[a-zA-Z_][a-zA-Z0-9_-]*"
    },
    "escape": {
      "name": "constant.character.escape.htmlang",
      "match": "\\\\(?:\\\\|\\$|@|\\{|\\}|\\[|\\]|,|\"|--)"
    },
    "variable": {
      "name": "variable.other.htmlang",
      "match": "\\$(?:--[a-zA-Z]|[a-zA-Z_])[a-zA-Z0-9_]*(?:-+[a-zA-Z0-9_]+)*|\\$\\{[^{}]*\\}"
    },
    "range": {
      "name": "keyword.operator.range.htmlang",
      "match": "(?<=[0-9a-zA-Z_})])\\.\\.(?=[-$0-9(])"
    },
    "attributes": {
      "name": "meta.attribute-list.htmlang",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.htmlang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.htmlang"
        }
      },
      "patterns": [
        {
          "include": "#conditional"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#escape"
        },
        {
          "include": "#string"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#color"
        },
        {
          "include": "#number"
        },
        {
          "include": "#state-prefix"
        },
        {
          "include": "#html-attribute"
        },
        {
          "include": "#attribute-name"
        },
        {
          "name": "punctuation.separator.comma.htmlang",
          "match": ","
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.htmlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "state-prefix": {
      "name": "keyword.other.state.htmlang",
      "match": "(?:[a-z0-9-]+|nth:[^:\\s,\\]]+|has\\([^)]*\\)):(?=[a-z])"
    },
    "attribute-name": {
      "name": "support.type.property-name.htmlang",
      "match": "\\b(?:spacing|center-x|center-y|align-left|align-right|align-top|align-bottom|wrap|grid-cols|grid-rows|col-span|row-span|inline|padding|margin|width|height|min-width|max-width|min-height|max-height|background|color|border|border-radius|font-size|font-weight|font-family|line-height|text-align|display|gap|flex|position|overflow|opacity|cursor|transition|transform|box-shadow|z-index)\\b"
    },
    "literal-inline": {
      "comment": "{@code ...} and {@textarea ...}: their text is shown as written, so a {@...} in it is text",
      "name": "meta.inline-element.htmlang",
      "begin": "(\\{)(@(?:code|textarea))(?![a-zA-Z0-9_-])",
      "end": "(\\})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.braces.begin.htmlang"
        },
        "2": {
          "name": "entity.name.tag.htmlang"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.section.braces.end.htmlang"
        }
      },
      "contentName": "markup.inline.raw.htmlang",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#literal-braces"
        }
      ]
    },
    "literal-braces": {
      "comment": "Braces inside literal text, kept as written and balanced",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#literal-braces"
        }
      ]
    },
    "inline-element": {
      "name": "meta.inline-element.htmlang",
      "begin": "(\\{)(?=@)",
      "end": "(\\})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.braces.begin.htmlang"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.section.braces.end.htmlang"
        }
      },
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#literal-inline"
        },
        {
          "include": "#inline-element"
        },
        {
          "include": "#element"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "color": {
      "name": "constant.other.color.htmlang",
      "match": "#[0-9a-fA-F]{3,8}\\b"
    },
    "number": {
      "name": "constant.numeric.htmlang",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "html-attribute": {
      "name": "entity.other.attribute-name.htmlang",
      "match": "\\b[a-zA-Z][a-zA-Z0-9_.-]*(?==)"
    },
    "conditional": {
      "comment": "A whole attribute if(CONDITION, A, B); an if( inside a value is CSS's own",
      "match": "(?:(?<=\\[)|(?<=,)|^)(\\s*)(if)(?=\\()",
      "captures": {
        "2": {
          "name": "keyword.control.conditional.htmlang"
        }
      }
    }
  }
}
