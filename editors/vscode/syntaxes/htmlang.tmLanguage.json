{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "htmlang",
  "scopeName": "source.htmlang",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#raw-block"
    },
    {
      "include": "#page-directive"
    },
    {
      "include": "#let-definition"
    },
    {
      "include": "#include-directive"
    },
    {
      "include": "#element"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#inline-element"
    },
    {
      "include": "#color"
    },
    {
      "include": "#number"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-dash.htmlang",
      "match": "^\\s*--.*$"
    },
    "raw-block": {
      "name": "meta.raw.htmlang",
      "begin": "(@raw)\\s+(\"\"\")",
      "end": "(\"\"\")",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.htmlang"
        },
        "2": {
          "name": "punctuation.definition.string.begin.htmlang"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.htmlang"
        }
      },
      "contentName": "string.unquoted.raw.htmlang"
    },
    "page-directive": {
      "match": "(@page)\\s+(.*)",
      "captures": {
        "1": {
          "name": "keyword.control.directive.htmlang"
        },
        "2": {
          "name": "string.unquoted.page-title.htmlang"
        }
      }
    },
    "let-definition": {
      "match": "(@let)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)",
      "captures": {
        "1": {
          "name": "keyword.control.directive.htmlang"
        },
        "2": {
          "name": "variable.other.htmlang"
        }
      }
    },
    "include-directive": {
      "match": "(@(?:include|extends|markdown|svg|data))\\s+(.*)",
      "captures": {
        "1": {
          "name": "keyword.control.directive.htmlang"
        },
        "2": {
          "name": "string.unquoted.filename.htmlang"
        }
      }
    },
    "element": {
      "name": "entity.name.tag.htmlang",
      "match": "@(?:row|column|el|text|paragraph|image|link|raw|children|slot|fragment|script|nav|header|footer|main|section|article|aside|address|search|form|details|summary|dialog|figure|figcaption|blockquote|cite|fieldset|legend|noscript|datalist|list|item|dl|dt|dd|table|thead|tbody|tr|td|th|select|picture|progress|meter|output|canvas|button|label|option|textarea|time|mark|abbr|code|kbd|pre|h1|h2|h3|h4|h5|h6|input|hr|source|video|audio|iframe|grid|stack|in-front|behind)(?![a-zA-Z0-9_-])"
    },
    "function-call": {
      "name": "entity.name.function.htmlang",
      "match": "@[a-zA-Z_][a-zA-Z0-9_-]*"
    },
    "variable": {
      "name": "variable.other.htmlang",
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_-]*"
    },
    "attributes": {
      "name": "meta.attribute-list.htmlang",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.htmlang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.htmlang"
        }
      },
      "patterns": [
        {
          "include": "#variable"
        },
        {
          "include": "#color"
        },
        {
          "include": "#number"
        },
        {
          "include": "#state-prefix"
        },
        {
          "include": "#html-attribute"
        },
        {
          "include": "#attribute-name"
        },
        {
          "name": "punctuation.separator.comma.htmlang",
          "match": ","
        }
      ]
    },
    "state-prefix": {
      "name": "keyword.other.state.htmlang",
      "match": "(?:[a-z0-9-]+|nth:[^:\\s,\\]]+|has\\([^)]*\\)):(?=[a-z])"
    },
    "attribute-name": {
      "name": "support.type.property-name.htmlang",
      "match": "\\b(?:spacing|padding|padding-x|padding-y|width|height|min-width|max-width|min-height|max-height|center-x|center-y|align-left|align-right|align-top|align-bottom|background|color|border|rounded|bold|italic|underline|size|font|transition|cursor|opacity|text-align|line-height|overflow|position|z-index|wrap|gap|margin|hidden)\\b"
    },
    "inline-element": {
      "name": "meta.inline-element.htmlang",
      "begin": "(\\{)(?=@)",
      "end": "(\\})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.braces.begin.htmlang"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.section.braces.end.htmlang"
        }
      },
      "patterns": [
        {
          "include": "#element"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "color": {
      "name": "constant.other.color.htmlang",
      "match": "#[0-9a-fA-F]{3,8}\\b"
    },
    "number": {
      "name": "constant.numeric.htmlang",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "html-attribute": {
      "name": "entity.other.attribute-name.htmlang",
      "match": "\\b[a-zA-Z][a-zA-Z0-9_.-]*(?==)"
    }
  }
}
