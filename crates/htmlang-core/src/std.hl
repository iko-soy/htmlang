-- The htmlang standard library, available in every file. It is ordinary
-- htmlang: a file's own @let with the same name takes precedence.

-- Takes up the remaining space in a row or column.
@let spacer
  @el [flex 1]

-- Cut text off at one line with an ellipsis: [$truncate]
@let truncate [overflow hidden, text-overflow ellipsis, white-space nowrap]
